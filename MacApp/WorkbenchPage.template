svg.addEventListener('focusin',e=>{if(wheelGesture||pan||drag||viewFrame||navDrag)return;const hit=e.target.closest('[data-point]');if(hit){const r=hit.getBoundingClientRect();infoAt(Number(hit.dataset.point),r.left+r.width/2,r.top+r.height/2,Number(hit.dataset.stage??-1))}});
svg.addEventListener('focusout',hideBubble);
svg.addEventListener('keydown',e=>{
 const hit=e.target.closest('[data-point]');if(!hit||!['ArrowUp','ArrowDown','ArrowRight','ArrowLeft','Enter',' '].includes(e.key))return;
 e.preventDefault();let i=Number(hit.dataset.point),ids=ordered();stageFocus=Number(hit.dataset.stage??-1);if(phaseDims.includes(dim))workbenchMenus.setValue($('phaseAxis'),dim);
 if(e.key==='ArrowRight'||e.key==='ArrowLeft')i=ids[Math.max(0,Math.min(ids.length-1,ids.indexOf(i)+(e.key==='ArrowRight'?1:-1)))];
 if(e.key==='ArrowUp'||e.key==='ArrowDown'){const dir=e.key==='ArrowUp'?1:-1,v=stageFocus>=0?stagePath(p.shots[i],dim)?.[stageFocus]:value(p.shots[i],dim),opts=axisOptions(dim);
 if(editStage(i,dim,stageFocus,dim==='sec'?Math.max(.5,(v||0)+dir*.5):opts[Math.min(opts.length-1,Math.max(0,opts.indexOf(v)+dir))])){
  selected=i;focusScriptParameter(dim,stageFocus)
 }}
 if(e.key==='Enter'||e.key===' '){selectGesturePoint({i,stage:stageFocus});openPointParameters(i,true);return}
 selectIndex(i);status();diagnose();(svg.querySelector('[data-point="'+i+'"][data-stage="'+stageFocus+'"]')||svg.querySelector('[data-point="'+i+'"]'))?.focus({preventScroll:true})
});
function openPointParameters(index,focus=false){
 cancelRailFold();
 const position=inspectorPosition();
 if(typeof finishWritingField==='function')finishWritingField();
 const reveal=()=>{if(focus&&!position)$('excerptHeading').focus({preventScroll:true})};
 if($('studioLayout').classList.contains('has-writer')){
  selectIndex(index,true);
  foldRail($('writingPane'),()=>{dismissWriting();inspector();reveal()});
  return;
 }
 selectIndex(index,true,position);reveal();
}
function cancelRailFold(){
 if(!railFold)return;
 railFold=null;delete $('studioLayout').dataset.folding;
}
function foldRail(panel,finish){
 if(railFold)return;
 const layout=$('studioLayout');
 layout.dataset.folding=panel===$('shotInspector')?'inspector':'full';
 // Keep both panes mounted until the horizontal slide and chart resize finish.
 const ticket={};railFold=ticket;
 function complete(){
  if(railFold!==ticket)return;
  railFold=null;finish();delete layout.dataset.folding;
 }
 const motions=[...panel.getAnimations(),...$('rightRail').getAnimations()].filter(a=>
  a.transitionProperty==='transform'||a.transitionProperty==='width');
 if(!motions.length){complete();return}
 Promise.allSettled(motions.map(a=>a.finished)).then(complete);
}
function closeInspector(restoreFocus=false){
 if(!editing)return;
 foldRail($('shotInspector'),()=>{
  editing=false;hideBubble();inspector();drawGraph();
  if(restoreFocus)$('editHere').focus({preventScroll:true});
 });
}
$('editHere').onclick=()=>openPointParameters(selected,true);
$('closeEdit').onclick=()=>closeInspector(true);

function installRailDivider(){
 const layout=$('studioLayout'),rail=$('rightRail'),divider=$('railDivider');
 const preference='workbench.railWidthPercent';
 let gesture=null,frame=0,preferred=0;
 function setPreferred(percent){
  preferred=percent;
  if(percent)layout.style.setProperty('--preferred-rail',percent+'vw');
  else layout.style.removeProperty('--preferred-rail');
 }
 try{
  const value=Number(localStorage.getItem(preference));
  if(value>0&&value<=50)setPreferred(value);
 }catch{}
 function saveWidth(){
  try{
   if(preferred)localStorage.setItem(preference,String(preferred));
   else localStorage.removeItem(preference);
  }catch{}
 }
 function limits(){
  const pane=layout.classList.contains('has-writer')?$('writingPane'):$('shotInspector');
  const width=layout.getBoundingClientRect().width;
  return {width,min:parseFloat(getComputedStyle(pane).minWidth),max:width/2};
 }
 function setWidth(px){
  const {min,max,width}=limits();
  setPreferred(px<=min+.25?0:Math.min(px,max)*100/width);
 }
 function describe(){
  if(!divider.getClientRects().length)return;
  const {min,max,width}=limits(),percent=n=>Math.round(n*100/width);
  const current=percent(clamp(rail.getBoundingClientRect().width,min,max));
  divider.setAttribute('aria-valuemin',String(percent(min)));
  divider.setAttribute('aria-valuemax','50');
  divider.setAttribute('aria-valuenow',String(current));
  divider.setAttribute('aria-valuetext','占窗口宽度的'+current+'%');
 }
 function move(){
  frame=0;
  if(gesture)setWidth(gesture.width+gesture.start-gesture.x);
 }
 function finish(event){
  if(!gesture||(event.pointerId!=null&&event.pointerId!==gesture.id))return;
  cancelAnimationFrame(frame);frame=0;
  if(event.type==='pointerup'){gesture.x=event.clientX;move()}
  else setPreferred(gesture.before);
  const id=gesture.id;gesture=null;
  describe();layout.classList.remove('resizing-rail');
  if(divider.hasPointerCapture(id))divider.releasePointerCapture(id);
  if(event.type==='pointerup')saveWidth();
 }
 divider.onpointerdown=event=>{
  if(event.button!==0||!event.isPrimary||gesture)return;
  event.preventDefault();
  gesture={id:event.pointerId,start:event.clientX,x:event.clientX,width:rail.getBoundingClientRect().width,before:preferred};
  layout.classList.add('resizing-rail');divider.setPointerCapture(event.pointerId);
 };
 divider.onpointermove=event=>{
  if(gesture?.id!==event.pointerId)return;
  gesture.x=event.clientX;
  if(!frame)frame=requestAnimationFrame(move);
 };
 divider.onpointerup=divider.onpointercancel=divider.onlostpointercapture=finish;
 window.addEventListener('blur',finish);
 divider.ondblclick=()=>{setPreferred(0);saveWidth()};
 divider.onkeydown=event=>{
  const width=rail.getBoundingClientRect().width,step=event.shiftKey?32:8;
  if(event.key==='Home')setPreferred(0);
  else if(event.key==='End')setPreferred(50);
  else if(event.key==='ArrowLeft')setWidth(width+step);
  else if(event.key==='ArrowRight')setWidth(width-step);
  else return;
  event.preventDefault();saveWidth();
 };
 const observer=new ResizeObserver(describe);
 observer.observe(rail);observer.observe(layout);
}
installRailDivider();
$('shotInspector').addEventListener('keydown',e=>{
 if(e.key==='Escape'&&!document.querySelector('dialog[open]'))closeInspector(true);
});
function sourceCopy(){
 if($('sourceVersion').value==='current'&&typeof workingManuscript==='function')return workingManuscript();
 if(typeof p.sourceText==='string'&&p.sourceText)return p.sourceText;
 if(p.shots.every(s=>s.kind==='分镜主值标注')&&p.shots.length===46&&p.title==='发送失败的爱')return demoText;
 return [p.intro,...p.groups.flatMap((g,i)=>[g.name,g.context,...p.shots.filter(s=>s.group===i).map(s=>s.body),g.assets])].filter(Boolean).join('\n\n')
}
let sourceHits=[],hitIndex=0;
function readSource(query=''){
 const root=$('fullSource'),src=sourceCopy();root.replaceChildren();sourceHits=[];hitIndex=0;
 if(!query){root.textContent=src;$('matchCount').textContent='';$('findNext').disabled=true;return}
 let at=0,index;const frag=document.createDocumentFragment();
 while((index=src.indexOf(query,at))>=0&&sourceHits.length<1500){
  frag.append(document.createTextNode(src.slice(at,index)));const m=document.createElement('mark');m.textContent=query;frag.append(m);sourceHits.push(m);at=index+query.length
 }
 frag.append(document.createTextNode(src.slice(at)));root.append(frag);$('findNext').disabled=!sourceHits.length;showMatch(0)
}
function showMatch(i){if(!sourceHits.length){$('matchCount').textContent='没有匹配';return}
 sourceHits[hitIndex]?.classList.remove('current');hitIndex=i%sourceHits.length;const m=sourceHits[hitIndex];m.classList.add('current');m.scrollIntoView({block:'center'});$('matchCount').textContent=(hitIndex+1)+' / '+sourceHits.length}
$('readAll').onclick=()=>{workbenchMenus.setValue($('sourceVersion'),p.shots.some(changed)?'current':'original');$('sourceTitle').textContent=p.title;$('sourceFind').value='';$('sourceDialog').showModal();readSource();$('fullSource').scrollTop=0};
$('sourceVersion').onchange=()=>readSource($('sourceFind').value.trim());
$('sourceFind').oninput=e=>readSource(e.target.value.trim());$('findNext').onclick=()=>showMatch(hitIndex+1);
$('sourceFind').onkeydown=e=>{if(e.key==='Enter'&&sourceHits.length){e.preventDefault();showMatch(hitIndex+1)}};
window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue=''}});
installBoardControls();hydrate();render();
new ResizeObserver(()=>{
