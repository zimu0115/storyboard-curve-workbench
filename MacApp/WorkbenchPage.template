function drawOverview(ids,v){
 const el=$('overview'),ct=ids.length,max=chart.max;
 const key=[revision,dim,groupFilter,roleFilter,max,ct].join('/');
 if(overviewCache?.project!==p||overviewCache.key!==key||!el.firstElementChild){
  const options=axisOptions(dim),categorical=dims[dim].cat;
  const yAt=n=>21-16*(dim==='sec'?n:options.indexOf(n))/max;
  let solid='',dashed='',previous=null,gap=false;
  ids.forEach((id,j)=>{
   const shot=p.shots[id],x=(j+.5)/ct*720;
   const nodes=stageNodes(shot,dim);
   const levels=nodes.filter(node=>node.v!=null).map(node=>yAt(node.v));
   if(levels.length>1){
    const low=Math.min(...levels),high=Math.max(...levels);
    if(low!==high)dashed+=` M${x} ${low}V${high}`;
   }
   for(const node of nodes){
    if(node.v==null){
     // Keep the last measured point across gaps, with the same black-card break as the main graph.
     if(roleOf(shot)==='card')previous=null;
     gap=true;
     continue;
    }
    const y=yAt(node.v);
    if(categorical)solid+=` M${x} ${y}h1`;
    else if(previous&&previous.j!==j){
     const segment=` M${previous.x} ${previous.y}L${x} ${y}`;
     if(gap)dashed+=segment;
     else solid+=segment;
    }
    previous={j,x,y};
    gap=false;
   }
  });
  el.setAttribute('viewBox','0 0 720 26');el.setAttribute('preserveAspectRatio','none');
  const pathStyle={fill:'none','vector-effect':'non-scaling-stroke'};
  el.innerHTML=graphShape('path',{...pathStyle,d:solid,stroke:'var(--plot-original)','stroke-width':.8})+
   (dashed?graphShape('path',{...pathStyle,d:dashed,stroke:'var(--plot-gap)','stroke-width':1,'stroke-dasharray':'1.5 2','stroke-linecap':'round'}):'')+
   graphShape('rect',{y:1,height:24,rx:3,fill:'var(--plot-window)',stroke:'var(--plot-gap)','vector-effect':'non-scaling-stroke'});
  overviewCache={project:p,key,box:el.lastElementChild};
