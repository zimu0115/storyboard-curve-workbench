<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title>子牧曲镜工作台</title>
<style>
/* 牧老板指定的苹果风格；#111111为固定强调黑色。 */
:root {
  --ui-ink: #111111;
  --ui-accent: #111111;
  --ui-muted: #6e6e73;
  --ui-bg: #f5f5f7;
  --ui-surface: #ffffff;
  --ui-soft: #f7f7f8;
  --ui-line: #e7e7eb;
  --ui-line-strong: #d2d2d7;
  --ui-radius-card: 20px;
  --ui-radius-control: 11px;
  --ui-shadow-card: 0 2px 6px rgba(17,17,17,.035), 0 12px 32px rgba(17,17,17,.055);
  --ui-shadow-hover: 0 4px 12px rgba(17,17,17,.055), 0 20px 44px rgba(17,17,17,.085);
  --ui-shadow-dialog: 0 12px 36px rgba(17,17,17,.12), 0 32px 96px rgba(17,17,17,.2);
  --ui-shadow-control: 0 2px 5px rgba(17,17,17,.12);
  --ui-shadow-control-hover: 0 6px 16px rgba(17,17,17,.2);
  --ui-motion: 180ms cubic-bezier(.2,.7,.3,1);
  --ui-font: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}
.ui-card {
  background: var(--ui-surface);
  border: 1px solid var(--ui-card-edge);
  border-radius: var(--ui-radius-card);
  box-shadow: var(--ui-shadow-card);
  transition: box-shadow var(--ui-motion), border-color var(--ui-motion), transform var(--ui-motion);
}
.ui-button {
  color: var(--ui-on-fill);
  background: var(--ui-accent);
  border: 1px solid var(--ui-accent);
  border-radius: var(--ui-radius-control);
  min-height: 40px;
  padding: 9px 16px;
  font: 500 14px/1.4 var(--ui-font);
  box-shadow: var(--ui-shadow-control);
  cursor: pointer;
  transition: box-shadow var(--ui-motion), transform var(--ui-motion), opacity var(--ui-motion);
}
.ui-button--secondary { color: var(--ui-ink); background: var(--ui-surface); border-color: var(--ui-line-strong); box-shadow: 0 1px 3px rgba(17,17,17,.04); }
.ui-button:active { transform: translateY(0); box-shadow: 0 1px 2px rgba(17,17,17,.1); }
.ui-button:disabled { opacity: .45; cursor: not-allowed; transform: none; }
.ui-button:focus-visible, .ui-card--interactive:focus-visible { outline: 2px solid var(--ui-accent); outline-offset: 4px; }
.ui-dialog { background: var(--ui-surface); border: 1px solid var(--ui-line); border-radius: 24px; box-shadow: var(--ui-shadow-dialog); }
@media (hover:hover) and (pointer:fine) {
  .ui-card--interactive:hover { transform: translateY(-2px); border-color: var(--ui-line-strong); box-shadow: var(--ui-shadow-hover); }
  .ui-button:not(:disabled):hover { transform: translateY(-1px); box-shadow: var(--ui-shadow-control-hover); }
  .ui-button:not(:disabled):active { transform: translateY(0); box-shadow: var(--ui-shadow-control); }
}
@media (prefers-reduced-motion:reduce) {
  .ui-card,.ui-button { transition: none; }
  .ui-card--interactive:hover,.ui-button:not(:disabled):hover,.ui-button:active { transform: none; }
}
*{box-sizing:border-box}
:root{font-family:var(--ui-font);color:var(--ui-ink);background:var(--ui-bg);font-size:15px;-webkit-font-smoothing:antialiased}
