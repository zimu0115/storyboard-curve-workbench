 const u=navPosition(e),v=viewport(),count=v.count===v.total?Math.max(minimumShotCount(v.total),v.count*.5):v.count;
 if(v.total<=1)return;
 const start=v.count===v.total||u<v.start||u>v.start+v.count?clamp(u-count/2,0,v.total-count):v.start;
 setWindow(start,count);
