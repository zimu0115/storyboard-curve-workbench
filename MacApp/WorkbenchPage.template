});
overview.addEventListener('pointermove',e=>{
 if(!navDrag||e.pointerId!==navDrag.id)return;
 const start=navPosition(e)-navDrag.offset;
 if(start!==viewport(chart.ids).start){navDrag.moved=true;panWindow(start)}
});
function endNav(e){
 if(!navDrag||e.pointerId!==navDrag.id)return;
 const finished=navDrag;
 navDrag=null;
 if(overview.hasPointerCapture(e.pointerId))overview.releasePointerCapture(e.pointerId);
 if(finished.moved){
  if(e.type==='pointerup')panWindow(navPosition(e)-finished.offset);
  settlePan(finished.start);
 }
}
