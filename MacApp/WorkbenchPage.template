 // Earlier drafts only recorded a local month, day and time.
 const parts=String(entry.at||'').match(/^(?:(\d{4})[/.-])?(\d{1,2})[/.-](\d{1,2})\s+(\d{1,2}):(\d{2})/);
 if(!parts)return 0;
 const today=new Date();
 const timestamp=new Date(parts[1]?Number(parts[1]):today.getFullYear(),Number(parts[2])-1,Number(parts[3]),Number(parts[4]),Number(parts[5]));
 if(!parts[1]&&timestamp>today)timestamp.setFullYear(timestamp.getFullYear()-1);
 return timestamp.getTime();
}
