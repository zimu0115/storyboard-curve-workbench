<script>

'use strict';
const $=id=>document.getElementById(id);
const dims={
 size:{name:'景别',opts:['远景','全景','中全景','中景','中近景','近景','特写','大特写'],color:'#2a785b'},
 pitch:{name:'俯仰',opts:['大俯拍','俯拍','平视','仰拍','大仰拍'],color:'#346e8c'},
 height:{name:'机位高度',opts:['贴地','膝部','腰部','胸肩','眼高','高位','空中'],color:'#856c40'},
 motion:{name:'镜头运动',opts:['固定','摇摄','推近','拉远','横移','跟拍','手持跟拍','复合运动'],cat:true,color:'#7d6396'},
 pov:{name:'观察视点',opts:['客观旁观','过肩','人物主观','直视观众','混合视点'],cat:true,color:'#ab613a'},
 sec:{name:'镜头时长',color:'#9b5843'}
};
const keys=Object.keys(dims),fmt=n=>String(n).padStart(2,'0');
const time=n=>{const d=Math.round(n*10);return fmt(Math.floor(d/600))+':'+fmt(Math.floor(d/10)%60)+(d%10?'.'+d%10:'')};
const copyObj=o=>JSON.parse(JSON.stringify(o));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const plain=s=>s.replace(/\\([\[\]~])/g,'$1').replace(/\*\*/g,'').trim();
const cut=s=>Array.from(s).slice(0,29).join('');
const signature='shot-curves-v1', storageKey='zimu.shot-curves.v1';
const toast=$('toast');
function placeToast(){
 const host=document.activeElement?.closest('dialog[open]')||document.querySelector('dialog[open]')||document.body;
 if(toast.parentElement!==host)host.append(toast);
 toast.showPopover?.();
}
function showToast(msg){
 clearTimeout(showToast.timer);
 toast.textContent=msg;toast.classList.remove('off');placeToast();
 showToast.timer=setTimeout(()=>{
  toast.hidePopover?.();toast.classList.add('off');
 },3500);
}
const toastDialogs=new MutationObserver(()=>{if(!toast.classList.contains('off'))placeToast()});
for(const dialog of document.querySelectorAll('dialog'))toastDialogs.observe(dialog,{attributes:true,attributeFilter:['open']});
function first(t,rules){for(const [re,v] of rules)if(re.test(t))return v;return null}
function infer(t,seconds){
 const size=first(t,[[/大特写|极特写/,'大特写'],[/特写|近摄/,'特写'],[/中近景/,'中近景'],[/中全景|中远景/,'中全景'],[/近景/,'近景'],[/中景/,'中景'],[/大全景|远景/,'远景'],[/全景/,'全景']]);
 return {size,pitch:first(t,[[/垂直俯|大俯|鸟瞰/,'大俯拍'],[/俯拍|俯视|俯看|斜向下/,'俯拍'],[/大仰|虫视/,'大仰拍'],[/仰角|仰视|仰拍/,'仰拍'],[/平视|水平拍/,'平视']]),
 height:first(t,[[/航拍|无人机/,'空中'],[/贴地|贴雪|鞋面高度/,'贴地'],[/膝高|膝盖高度|膝盖，|大腿高度/,'膝部'],[/腰高|桌沿等高|桌面高度|桌边手部/,'腰部'],[/胸高|胸口高度|肩高/,'胸肩'],[/眼高|眼线|眼睛等高|人眼同高/,'眼高'],[/高位|高机位/,'高位']]),
 motion:first(t,[[/手持.*跟|跟.*手持/,'手持跟拍'],[/拉远.*摇|后退.*摇/,'复合运动'],[/跟拍|跟退|侧跟|短跟|第一人称.*走/,'跟拍'],[/摇摄|平摇|上摇|下摇|横摇|轻摇|短摇/,'摇摄'],[/推近|推镜/,'推近'],[/拉远|后退/,'拉远'],[/横移|平移/,'横移'],[/固定|机位不动/,'固定']]),
 pov:first(t,[[/直视观众|直视镜头|第四面墙/,'直视观众'],[/主观|第一人称|POV/i,'人物主观'],[/过肩|肩后|肩侧/,'过肩'],[/客观|旁观/,'客观旁观']]),sec:seconds||null}
}
const shotMarker=/^(?:#{1,6}\s*)?(?:\[\s*|【\s*)?(?:第\s*(?=\d)|分镜|镜头|镜|SHOT)\s*([0-9]+[A-Za-z]?)(?:镜头|镜)?(?=$|[\s\]】（(:：、.·|｜\-—])/i;
const manuscriptMarker=/^### 镜(.+?)　(?=时间待定|\d+:\d{2})/m;
const matchShotHeader=line=>line.match(manuscriptMarker)||line.match(shotMarker);
const groupMarker=/^(?:##\s+\d+[\s　]+|(?:#{1,5}\s*)?【?(?:第[〇零一二三四五六七八九十百\d]+场|场景\s*\d+|场次\s*\d+|场\s*\d+[ ·：:、]))/;
const suggestionHeading=/^[ \t]*(?:#{1,6}[ \t]+)?(?:\*\*|__|【)?(?:二次修改建议|修改建议|修改意见)(?:[：:](?:\*\*|__|】)?[ \t　]*|(?:\*\*|__|】)[ \t　]*[：:]?[ \t　]*|[ \t　]*$)(.*)$/;
const reviewBrief='**改稿范围**　请按各镜头的「修改建议」改写相应内容，其余镜头按当前正文保留。';
const migratedProjects=new WeakSet();
const spacerLine=line=>/^\s*(?:<br\s*\/?>|>\s*)?\s*$/i.test(line);
function trimFieldPadding(lines){
 let first=0,last=lines.length;
 while(first<last&&spacerLine(lines[first]))first++;
 while(last>first&&spacerLine(lines[last-1]))last--;
 return lines.slice(first,last).join('\n');
}
function splitSuggestionSections(text){
 const body=[],parts=[];let part=null;
 for(const line of text.split(/\r?\n/)){
  const heading=line.match(suggestionHeading);
  if(heading){
   if(part)parts.push(trimFieldPadding(part));
   part=[heading[1]];
  }else{
   if(part&&/^(?:\*\*(?:机位与取景|人物与动作|对白、声音与切点|拍摄补充|本段所需素材)|镜头用途[：:]|导演标记[：:])/.test(line)){
    parts.push(trimFieldPadding(part));part=null;
   }
   (part||body).push(line);
  }
 }
 if(part)parts.push(trimFieldPadding(part));
 return {found:parts.length>0,body:parts.length?trimFieldPadding(body):text,suggestion:parts.filter(Boolean).join('\n\n')};
}
function migrateShotSuggestions(s){
 if(Object.hasOwn(s,'suggestion'))return false;
 const notes=[];let found=false;
 for(const field of ['camera','action','sound','note']){
  const base=splitSuggestionSections(s[field]);
  const edited=s.prose?.[field]!==undefined;
  const current=edited?splitSuggestionSections(s.prose[field]):base;
  if(!base.found&&!current.found)continue;
  found=true;s[field]=base.body;
  if(current.suggestion)notes.push(current.suggestion);
  if(edited){
   if(current.body===base.body){delete s.prose[field];if(field==='camera')delete s.proseCameraValues}
   else s.prose[field]=current.body;
  }
 }
 if(s.prose&&!Object.keys(s.prose).length)delete s.prose;
 s.suggestion=notes.join('\n\n');
 if(found)s.body=splitSuggestionSections(s.body).body;
 return found;
}
function newGroup(name){return {name:name||'故事节点',context:'',assets:''}}
function createShot(id,group,title,camera,action,sound,seconds,kind,body){const base=infer(camera,seconds);return {id,group,title,camera,action,sound,body,kind,base,edits:{},hold:false,note:'',suggestion:''}}
function parseText(raw,name=''){
 const lines=raw.replace(/^\uFEFF/,'').replace(/\r\n?/g,'\n').split('\n'), t=lines.find(s=>/^#\s+/.test(s));
 const p={format:signature,sourceText:raw,title:t?plain(t.replace(/^#\s*/,'')):name.replace(/\.(md|txt)$/i,'')||'新作品',intro:'',groups:[],shots:[]};
 const numbered=lines.some(l=>matchShotHeader(plain(l)));const hasScenes=lines.some(x=>groupMarker.test(plain(x)));
 const markdownShots=numbered&&lines.some(l=>/^#{1,6}\s/.test(l)&&matchShotHeader(plain(l)));
 let group=-1, h='',body=[],groupIntro=[], assetsMode=false,secHead='',para=[],readingSuggestion=false;
 function ensure(){if(group<0){group=0;p.groups.push(newGroup('开场'))}return group}
 function storeIntro(){if(groupIntro.length){if(group>=0)p.groups[group].context=groupIntro.join('\n').trim();else p.intro=groupIntro.join('\n').trim();groupIntro=[]}}
 function flushShot(){
  if(!h)return;
  const refs=boardReferences(body.join('\n'));
  if(refs.length)body=body.filter(l=>!(/^\s*!\[/.test(l)&&boardReferences(l).length||boardLabel.test(l)));
  const annotation=splitSuggestionSections(body.join('\n'));
  if(annotation.found)body=annotation.body.split('\n');
  const header=plain(h),m=matchShotHeader(header),rows=body.filter(l=>l.trim()),fields={camera:[],action:[],sound:[],note:[]};let intentionalHold=false;
  let channel='';const exact=rows.some(l=>/^\*\*机位与取景/.test(l.trim()));
  for(const l of (exact?body:rows)){
   const line=plain(l).replace(/^\*\s+/,'');
   if(/^(镜头用途|镜内(?:景别|俯仰|机位高度|观察视点))[：:　 ]/.test(line))continue;
   if(line==='导演标记：此处有意保持。'){intentionalHold=true;continue}
   const lab=line.match(/^(机位与取景|人物与动作|对白、声音与切点|拍摄补充)\s*(.*)/);
   if(lab){channel={机位与取景:'camera',人物与动作:'action','对白、声音与切点':'sound',拍摄补充:'note'}[lab[1]];const rawField=l.match(/^\s*(?:\*\*)?(?:机位与取景|人物与动作|对白、声音与切点|拍摄补充)(?:\*\*)?[　 	]*(.*)$/);
    fields[channel].push(rawField?rawField[1]:lab[2]);continue}
   if(exact){if(channel)fields[channel].push(l);continue}
   if(/^(镜头运动|机位|摄影|视觉构图|镜头参数|景别|焦点转移|机位与取景)[：:]/.test(line))fields.camera.push(line);
   else if(/^(声音|音效|字幕|画外|台词|.*[：:]\s*[“「"])/.test(line))fields.sound.push(line);
   else fields.action.push(line)
  }
  const stripped=header.slice(m[0].length).replace(/^[\s\]】.、:：-]+/,'');
  const timed=header.match(/[（(](\d+(?:\.\d+)?)秒[）)]/);
  const title=header.includes('｜')?header.split('｜').at(-1):stripped||'镜'+m[1];
  if(!exact&&stripped)fields.camera.unshift(stripped);
  const s=createShot(m[1],ensure(),title,fields.camera.join('\n').trim(),fields.action.join('\n').trim(),fields.sound.join('\n').trim(),timed?Number(timed[1]):null,'分镜提取',h+'\n'+body.join('\n').trim());
  if(refs.length)s.storyboardRefs=refs;
  if(!exact){const extra=infer(stripped+'\n'+fields.camera.join('\n')+'\n'+fields.action.join('\n'),s.base.sec);for(const k of keys)if(s.base[k]==null)s.base[k]=extra[k]}
  s.note=fields.note.join('\n').trim();s.hold=intentionalHold;s.suggestion=annotation.suggestion;
  p.shots.push(s);h='';body=[];readingSuggestion=false;
 }
 function flushBeat(){if(!para.length)return;const action=para.join('\n').trim();para=[];if(!action)return;
  const isDialogue=/[“「]|^\s*\*\*.+?\*\*|^[^。！？\n]{1,12}[：:]/m.test(action);
  const g=ensure(),firstInScene=!p.shots.some(s=>s.group===g);
  const detail=/手指|屏幕|纸条|照片|特写|信封/.test(action);
  const move=/跑|追上|穿过|追出|奔向/.test(action);
  const shot=createShot(fmt(p.shots.length+1),g,cut(plain(action).split('\n')[0]),'',action,'',null,'剧本建议',action);
  shot.base={size:firstInScene?'全景':detail?'特写':isDialogue?'中近景':'中景',pitch:'平视',height:'眼高',motion:move?'跟拍':'固定',pov:'客观旁观',sec:Math.min(60,Math.max(3,Math.ceil((action.match(/[\u3400-\u9fff]/g)||[]).length/(isDialogue?5:10))))};
  const refs=boardReferences(action);if(refs.length)shot.storyboardRefs=refs;
  p.shots.push(shot)
 }
 for(const l of lines){const clean=plain(l);
